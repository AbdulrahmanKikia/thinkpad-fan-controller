<Window x:Class="LibraryFan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LibraryFan"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ThinkPad Fan Controller Utility"
        Width="1120" Height="760" MinWidth="960" MinHeight="680"
        ShowInTaskbar="False"
        Background="#0B0E13" Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI Variable, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        AutomationProperties.AutomationId="LibraryFanWindow">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="True"/>
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- The caption is the app's own bar. The system buttons sit in the right margin. -->
    <Grid Margin="20,0,148,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <local:FanMark VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
        <TextBlock Text="ThinkPad Fan Controller Utility" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock x:Name="MachineNameText" Text="ThinkPad P1 Gen 3" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,1,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="LinkPill" Style="{StaticResource Surface}" Background="{StaticResource Raised}"
                Height="40" Padding="14,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="LinkDot" Width="8" Height="8" CornerRadius="4" Background="{StaticResource Muted}" VerticalAlignment="Center"/>
            <TextBlock x:Name="LinkText" Text="OFFLINE" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="LinkText"/>
          </StackPanel>
        </Border>
        <Border x:Name="ModeBadge" VerticalAlignment="Center" Margin="8,0,0,0"
                MinWidth="120" Height="40" CornerRadius="12" Padding="16,0"
                Background="{StaticResource Teal}">
          <TextBlock x:Name="ModeBadgeText" Text="BIOS" FontSize="12" FontWeight="SemiBold"
                     Foreground="{StaticResource OnAccent}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     AutomationProperties.AutomationId="ModeBadge"/>
        </Border>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="20,0,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Style="{StaticResource Surface}" Padding="16,12">
      <StackPanel>
        <TextBlock x:Name="ReasonText" TextWrapping="Wrap" FontSize="20" FontWeight="SemiBold"
                   AutomationProperties.AutomationId="ReasonText"/>
        <TextBlock x:Name="RefusalText" TextWrapping="Wrap" FontSize="13"
                   Foreground="{StaticResource Coral}" Margin="0,6,0,0" Visibility="Collapsed"
                   AutomationProperties.AutomationId="RefusalText"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="1.6*"/>
      </Grid.ColumnDefinitions>
      <local:FanRing x:Name="Fan1" Margin="0,0,8,0" AutomationProperties.AutomationId="Fan1Rpm"/>
      <local:FanRing x:Name="Fan2" Grid.Column="1" Margin="8,0" AutomationProperties.AutomationId="Fan2Rpm"/>
      <Border Grid.Column="2" Style="{StaticResource Surface}" Padding="16" Margin="8,0,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel>
            <TextBlock Text="LAST THREE MINUTES" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Border Width="16" Height="4" CornerRadius="2" Background="{StaticResource Teal}" VerticalAlignment="Center"/>
              <TextBlock Text="Hottest sensor" Foreground="{StaticResource Muted}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
              <Border Width="16" Height="4" CornerRadius="2" Background="{StaticResource Amber}" VerticalAlignment="Center" Margin="12,0,0,0"/>
              <TextBlock Text="Faster fan" Foreground="{StaticResource Muted}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </DockPanel>
          <Grid Grid.Row="1" Margin="0,10,0,0">
            <TextBlock x:Name="TracePlaceholder" Text="Waiting for the first samples."
                       Foreground="{StaticResource Muted}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Canvas x:Name="TraceCanvas" ClipToBounds="True"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource Surface}" Padding="8" Margin="0,8,0,0">
      <UniformGrid x:Name="SensorHost" Columns="12" Rows="1"/>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource Surface}" Padding="12" Margin="0,8,0,0">
      <Grid VerticalAlignment="Center">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="MODE" Style="{StaticResource SectionLabel}"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="BiosButton" Content="BIOS" MinWidth="112" Click="BiosClick"
                    Style="{StaticResource ModeButton}" AutomationProperties.AutomationId="ModeBios"/>
            <Button x:Name="LibraryButton" Content="Library" MinWidth="112" Margin="8,0,0,0" Click="LibraryClick"
                    Style="{StaticResource ModeButton}" AutomationProperties.AutomationId="ModeLibrary"/>
            <Button x:Name="ManualButton" Content="Manual" MinWidth="112" Margin="8,0,0,0" Click="ManualClick"
                    Style="{StaticResource ModeButton}" AutomationProperties.AutomationId="ModeManual"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock x:Name="RegisterLabel" Text="REGISTER 0x2F" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right"/>
          <StackPanel x:Name="LevelHost" Orientation="Horizontal" Margin="0,8,0,0"/>
        </StackPanel>
        <!-- The quiet curve, with the step Library is holding marked. -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
          <TextBlock Text="LIBRARY CURVE" Style="{StaticResource SectionLabel}"/>
          <StackPanel x:Name="CurveHost" Orientation="Horizontal" Margin="0,8,0,0"/>
        </StackPanel>
        <TextBlock x:Name="CurveNote" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Foreground="{StaticResource Muted}" FontSize="12" Margin="16,0,0,4" TextWrapping="Wrap" TextAlignment="Right"/>
      </Grid>
    </Border>

    <Grid Grid.Row="4" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel x:Name="StatusHost" VerticalAlignment="Center">
        <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
        <TextBlock x:Name="HealthText" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                   Margin="0,2,0,0" AutomationProperties.AutomationId="HealthText"/>
      </StackPanel>
      <Border x:Name="SimPanel" Grid.Column="1" Style="{StaticResource Surface}" Padding="14,0" Height="40" Width="340"
              AutomationProperties.AutomationId="SimPanel">
        <DockPanel VerticalAlignment="Center">
          <TextBlock Text="Fake 0x78" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" DockPanel.Dock="Left"/>
          <TextBlock x:Name="SimTempLabel" Foreground="{StaticResource Ink}" FontSize="13" FontWeight="SemiBold"
                     Width="40" TextAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="8,0,0,0"/>
          <Slider x:Name="SimTemp" Minimum="30" Maximum="95" Value="48" Margin="12,0,0,0"
                  Style="{StaticResource MeterSlider}" VerticalAlignment="Center"
                  AutomationProperties.AutomationId="SimTemp"/>
        </DockPanel>
      </Border>
    </Grid>
    </Grid>
  </Grid>
</Window>
