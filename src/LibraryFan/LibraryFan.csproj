<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>LibraryFan</RootNamespace>
    <AssemblyName>LibraryFan</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LibraryFan.Core\LibraryFan.Core.csproj" />
    <None Include="..\LibraryFan.Core\library-curve.json" Link="library-curve.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
