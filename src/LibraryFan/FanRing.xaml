<UserControl x:Class="LibraryFan.FanRing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <Border Style="{StaticResource Surface}" Padding="12,14">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
      <Grid Width="148" Height="148" HorizontalAlignment="Center">
        <Ellipse Stroke="{StaticResource Line}" StrokeThickness="10"/>
        <Ellipse x:Name="Marker" StrokeThickness="10" StrokeDashArray="1.2 16"
                 StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                 RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform>
            <RotateTransform x:Name="Spin"/>
          </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="100" Height="100" Fill="#10151C"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="RpmText" Foreground="{StaticResource Ink}" FontSize="32"
                     FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock x:Name="UnitText" Text="RPM" Foreground="{StaticResource Muted}"
                     FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>
      </Grid>
      <TextBlock x:Name="CaptionText" Foreground="{StaticResource Ink}" FontSize="15"
                 FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
      <TextBlock x:Name="CommandTextBlock" Foreground="{StaticResource Muted}" FontSize="12"
                 FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
    </StackPanel>
  </Border>
</UserControl>
