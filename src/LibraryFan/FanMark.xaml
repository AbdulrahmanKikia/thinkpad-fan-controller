<UserControl x:Class="LibraryFan.FanMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="22" Height="22" IsHitTestVisible="False">
  <Grid>
    <Ellipse Stroke="{StaticResource Line}" StrokeThickness="2" Margin="1"/>
    <Ellipse Margin="1" Stroke="{StaticResource Teal}" StrokeThickness="2.2"
             StrokeDashArray="4.4 3.2" StrokeDashCap="Round"
             RenderTransformOrigin="0.5,0.5">
      <Ellipse.RenderTransform>
        <RotateTransform Angle="-16"/>
      </Ellipse.RenderTransform>
    </Ellipse>
  </Grid>
</UserControl>
